{
  "name": "luro",
  "version": "0.2.0",
  "description": "Local Markdown blog editor — write, preview, and publish static HTML with Git push.",
  "author": "luro",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json && tsc -p tsconfig.electron.json && cp electron/preload.cjs dist/electron/preload.cjs",
    "build:electron": "tsc -p tsconfig.electron.json && cp electron/preload.cjs dist/electron/preload.cjs",
    "start": "node dist/server/index.js",
    "preview": "vite preview",
    "postinstall": "electron-rebuild -f -w node-pty || true",
    "electron:dev": "npm run build && ELECTRON_RUN=1 electron .",
    "build:mac": "npm run build && electron-builder --mac --x64 --arm64 && bash scripts/rename-intel-dmg.sh",
    "build:mac:signed": "npm run build && electron-builder --mac --x64 --arm64 && bash scripts/rename-intel-dmg.sh",
    "build:win": "npm run build && electron-builder --win --x64 --arm64",
    "build:all": "npm run build && electron-builder --mac --x64 --arm64 --win --x64 --arm64 && bash scripts/rename-intel-dmg.sh",
    "staple:dmg": "bash scripts/staple-dmg.sh"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "markdown-it": "^14.1.0",
    "multer": "^1.4.5-lts.1",
    "node-pty": "^1.1.0",
    "pinyin-pro": "^3.26.0",
    "simple-git": "^3.27.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^4.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/multer": "^1.4.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.lr4xt.luro",
    "productName": "luro",
    "icon": "build/icon.icns",
    "afterSign": "scripts/notarize.cjs",
    "files": [
      "dist/**/*",
      "config/**/*",
      "!config/tags.json",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "dmg": {
      "sign": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}-${os}.${ext}",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
